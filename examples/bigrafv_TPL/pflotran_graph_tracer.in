# Sept 12, 2018
# Matthew Sweeney, Satish Karra, Jeffrey Hyman (LANL)
#================================================

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
      OPTIONS
      /
    /
  /
  RESTART pflotran_graph_pressure-restart.h5 0.
END

SUBSURFACE

CHEMISTRY
#  LOG_FORMULATION
  PRIMARY_SPECIES
    TRACER
  /
  OUTPUT
    TOTAL
    TRACER
  /
END



#=========================== discretization ===================================
GRID
  TYPE unstructured_explicit full_mesh_vol_area.uge 
  GRAVITY 0.d0 0.d0 0.d0
END


#=========================== fluid properties =================================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
END

DATASET Permeability
  FILENAME dfn_properties.h5
END

#=========================== material properties ==============================
MATERIAL_PROPERTY fractures
  ID 1
  POROSITY 0.9d0 
  TORTUOSITY 1.0d0
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    DATASET Permeability
  /
END


#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES default
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.5d0
    ALPHA  1.d-4
    LIQUID_RESIDUAL_SATURATION 0.1d0
    MAX_CAPILLARY_PRESSURE 1.d8
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
END


#=========================== output options ===================================
OUTPUT
  #PERIODIC TIME 2.0d4 second
  #PERIODIC TIME 2.0d4 second
  PRINT_PRIMAL_GRID
  ACKNOWLEDGE_VTK_FLAW
  FORMAT VTK
  MASS_FLOWRATE
  MASS_BALANCE
  #CONSERVATION_FILE
  VARIABLES
    LIQUID_PRESSURE
    PERMEABILITY
  /
END

#=========================== times ============================================
#TIME
#  INITIAL_TIMESTEP_SIZE  1.d-8 s
#  FINAL_TIME 1.d6 s
#  MAXIMUM_TIMESTEP_SIZE 1.d6 s
#END

TIME
  INITIAL_TIMESTEP_SIZE  1.d-8 y
  FINAL_TIME 1.d2 y
  MAXIMUM_TIMESTEP_SIZE 1.d3 y
END

#======direct solve
#NUMERICAL_METHODS FLOW
#  LINEAR_SOLVER
#    SOLVER DIRECT
#  /
#END
#======direct solve
#NUMERICAL_METHODS TRANSPORT
#  LINEAR_SOLVER
#    SOLVER DIRECT
#  /
#END

#=========================== regions ==========================================
REGION All
  COORDINATES
    -5.d20 -5.d20 -5.d20
    5.d20 5.d20 5.d20
  /
END

REGION inflow
  FILE boundary_left_w.ex
  #FILE boundary_front_n.ex
END

REGION outflow
  FILE boundary_right_e.ex
  #FILE boundary_back_s.ex
END

#=========================== Transport conditions ==================================

TRANSPORT_CONDITION initial
  TYPE dirichlet 
    CONSTRAINT_LIST
    0.d0 initial
  /
END

TRANSPORT_CONDITION inject
  TYPE dirichlet
    CONSTRAINT_LIST
    #0.d0 inlet
    #1.0d-3 initial
    0.0d0 initial
    1d-3 inlet
    5d-3 initial
  /
END

TRANSPORT_CONDITION outlet
  TYPE dirichlet_zero_gradient
  CONSTRAINT_LIST
    0.d0 initial
  /
END


CONSTRAINT initial
  CONCENTRATIONS
    TRACER 1.0d-20 T
  /
END

CONSTRAINT inlet
  CONCENTRATIONS
    TRACER 1.d-3 T
  /
END

#=========================== flow conditions ==================================
FLOW_CONDITION initial
  TYPE
     LIQUID_PRESSURE dirichlet 
  /
  LIQUID_PRESSURE 1.2d6
  #LIQUID_PRESSURE 1.0005d6
END


FLOW_CONDITION outflow 
  TYPE 
     LIQUID_PRESSURE dirichlet
  /
  LIQUID_PRESSURE 1.0d6
END

FLOW_CONDITION inflow 
  TYPE
    LIQUID_PRESSURE dirichlet
  /
  LIQUID_PRESSURE 2.0d6
END

#=========================== condition couplers ===============================

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial
  TRANSPORT_CONDITION initial
  REGION All
END

BOUNDARY_CONDITION INFLOW 
  FLOW_CONDITION inflow
  TRANSPORT_CONDITION inject
  REGION inflow
END

BOUNDARY_CONDITION OUTFLOW
  FLOW_CONDITION outflow
  TRANSPORT_CONDITION outlet 
  REGION outflow
END


#=========================== stratigraphy couplers ============================
STRATA
  REGION All 
  MATERIAL fractures
END


END_SUBSURFACE

